# API runtime
DATABASE_URL=sqlite:///./sentinel.db
APP_SECRET=replace-with-a-long-random-local-secret
ALLOWED_ORIGINS=http://localhost:5173
# Optional separate read-only MCP listener. No keys are seeded.
MCP_ENABLED=false
MCP_ALLOWED_HOSTS=127.0.0.1:8001,localhost:8001
# Empty rejects browser-origin requests; headless agents can supply Bearer keys.
MCP_ALLOWED_ORIGINS=
SCHEDULE_ENABLED=false
SCHEDULE_HOUR=2
SCHEDULE_TIMEZONE=Asia/Kuala_Lumpur
ALERT_REMINDER_MINUTES=1440
ALERT_ESCALATION_MINUTES=2880

# Optional real chain adapter. Leave blank for an honestly unavailable chain state.
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
CHAIN_CONTRACT_ADDRESS=
CHAIN_ID=11155111
# Public test-wallet address representing the approved synthetic-data researcher.
CHAIN_RESEARCHER_ADDRESS=

# Deployment-facing values
VITE_API_BASE_URL=http://localhost:8000/api
SUPABASE_DB_URL=
