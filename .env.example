# API runtime
DATABASE_URL=sqlite:///./sentinel.db
APP_SECRET=replace-with-a-long-random-local-secret
ALLOWED_ORIGINS=http://localhost:5173
# Optional read-only MCP listener. It runs separately locally and is mounted at
# /mcp on the single hosted API service. No keys are seeded.
MCP_ENABLED=false
MCP_ALLOWED_HOSTS=127.0.0.1:8001,localhost:8001
# Empty rejects browser-origin requests; headless agents can supply Bearer keys.
MCP_ALLOWED_ORIGINS=
SCHEDULE_ENABLED=false
SCHEDULE_HOUR=2
SCHEDULE_TIMEZONE=Asia/Kuala_Lumpur
# Local default: local_apscheduler. Hosted Free-tier demo: github_actions.
SCHEDULER_MODE=local_apscheduler
# Required only for the authenticated GitHub Actions hosted-scan trigger.
SCHEDULER_TRIGGER_TOKEN=
# Enables only the idempotent fictional dataset/bootstrap on a fresh demo DB.
SEED_SYNTHETIC_DATA=false
# Fictional cohort size for a fresh database (12-10000). 100 is the documented
# fixture used by the tests; the care-setting mix scales proportionally.
SEED_PATIENT_COUNT=100
ALERT_REMINDER_MINUTES=1440
ALERT_ESCALATION_MINUTES=2880
# Staff-only Live Monitor. Only an administrator can start a run; it writes
# fictional HbA1c/FPG results in accelerated simulated time, runs the normal
# scan, and stops automatically after LIVE_SIMULATION_MAX_MINUTES.
LIVE_SIMULATION_ENABLED=true
LIVE_SIMULATION_TICK_SECONDS=5
LIVE_SIMULATION_DAYS_PER_TICK=7
LIVE_SIMULATION_MAX_MINUTES=30
LIVE_SIMULATION_MEAN_TEST_INTERVAL_DAYS=60

# Optional real chain adapter. Leave blank for an honestly unavailable chain state.
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
CHAIN_CONTRACT_ADDRESS=
CHAIN_ID=11155111
# Public test-wallet address representing the approved synthetic-data researcher.
CHAIN_RESEARCHER_ADDRESS=

# Deployment-facing values
VITE_API_BASE_URL=http://localhost:8000/api
SUPABASE_DB_URL=
